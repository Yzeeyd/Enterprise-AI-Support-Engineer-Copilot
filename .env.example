# ============================================================
# Provider Selection
# ============================================================

# Local development:
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OPENSEARCH_PROVIDER=local

# AWS deployment example:
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# OPENSEARCH_PROVIDER=serverless


# ============================================================
# OpenSearch
# ============================================================

# Local
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
INDEX_NAME=knowledge-base
PIPELINE_NAME=hybrid-rrf-pipeline

# AWS Serverless example:
# OPENSEARCH_HOST=your-collection-id.aoss.us-east-1.on.aws
# INDEX_NAME=knowledge-base-bedrock
# PIPELINE_NAME=hybrid-normalization-pipeline


# ============================================================
# Local Ollama
# ============================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:latest
OLLAMA_LLM_MODEL=qwen3.5:9b


# ============================================================
# AWS Bedrock
# ============================================================

AWS_REGION=us-east-1

BEDROCK_LLM_MODEL=qwen.qwen3-32b-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Do NOT put AWS access keys here.
# Local development should use AWS CLI credentials / aws login.
# Lambda uses its IAM execution role automatically.


# ============================================================
# Data / Runtime
# ============================================================

DATAPATH=data
INDEX_STATE_PATH=runtime/index_state.json