      "02_Password_and_MFA_Policy.pdf"
    ],
    "category": "direct"
  },
  {
    "id": "Q02",
    "question": "Do standard users have to rotate passwords every 90 days?",
    "expected_answer": "No. Routine password rotation is not required; change is required when compromise is suspected, after an admin reset, or following a breach notification.",
    "expected_sources": [
      "02_Password_and_MFA_Policy.pdf"
    ],
    "category": "direct"
  },
  {
    "id": "Q03",
    "question": "I received MFA prompts I did not request. What should I do?",
    "expected_answer": "Deny the prompt, change/reset the password, and report the event to Security Operations and the IT Service Desk.",
    "expected_sources": [
      "01_IT_Security_Policy.pdf",
      "02_Password_and_MFA_Policy.pdf",
      "06_IT_Support_FAQ.pdf",
      "05_Incident_Response_Quick_Runbook_SCANNED.pdf"
    ],
    "category": "multi_document"
  },
  {
    "id": "Q04",
    "question": "Can I connect to the company VPN from my personal laptop?",
