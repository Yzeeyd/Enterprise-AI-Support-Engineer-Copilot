  {
    "id": "Q05",
    "question": "After how many failed sign-in attempts can my account lock temporarily?",
    "expected_answer": "Five consecutive failed attempts within 15 minutes can trigger a 15-minute lockout.",
    "expected_sources": [
      "02_Password_and_MFA_Policy.pdf",
      "03_VPN_Troubleshooting_Guide_SCANNED.pdf"
    ],
    "category": "ocr_cross_reference"
  },
  {
    "id": "Q06",
    "question": "My VPN connects, but internal websites do not load. What should I check?",
    "expected_answer": "Reconnect once, verify the client shows Connected and has a corporate VPN address, then test the internal status page. If multiple internal services fail, collect diagnostics and escalate appropriately.",
    "expected_sources": [
      "03_VPN_Troubleshooting_Guide_SCANNED.pdf"
    ],
    "category": "ocr_only"
  },
  {
    "id": "Q07",
    "question": "How long can an idle VPN session remain connected?",
